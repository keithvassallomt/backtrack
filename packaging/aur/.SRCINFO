pkgbase = backtrack
	pkgdesc = Browse your files as they were: backups you can step back through, built on Borg
	pkgver = 0.1.0
	pkgrel = 1
	url = https://backtrack.tools
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	makedepends = cargo
	makedepends = gtk4
	makedepends = libadwaita
	options = !lto
	source = backtrack-0.1.0.tar.gz::https://github.com/keithvassallomt/backtrack/archive/refs/tags/v0.1.0.tar.gz
	sha256sums = SKIP

pkgname = backtrack
	depends = borg
	depends = cairo
	depends = glib2
	depends = glibc
	depends = gtk4
	depends = hicolor-icon-theme
	depends = libadwaita
	depends = libgcc
	depends = pango
	optdepends = backtrack-nautilus: Restore Previous Version in GNOME Files
	optdepends = backtrack-dolphin: Restore Previous Version in Dolphin

pkgname = backtrack-nautilus
	pkgdesc = Restore Previous Version in GNOME Files, for Backtrack
