#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# SPDX-FileCopyrightText: 2026 Keith Vassallo <keith@vassallo.cloud>
#
# Stage 18's checks on this computer, by hand: whether Rewind's motion looks
# smooth on real hardware, which no virtual machine can say, and its
# crossfade with animations off (S18-T3); a backup held up on battery saying
# so (S18-T10); hidden files, and a quick opening on a large catalogue (S18-T11
# and T12); a backup on battery that has waited long enough running anyway
# (S18-T14); the tray and the service restarting after an upgrade (S18-T13);
# the wallpaper on each desktop's VM (S18-T2, T19, T20); Rewind's window in
# front (S18-T4).
# Each step says what to do at the screen.
#
#   scripts/rewind-check install   build the AUR packages here and say how to
#                                  install them
#   scripts/rewind-check 1         the motion, through a real folder's backups
#   scripts/rewind-check 2         with animations off: a crossfade instead;
#                                  puts animations back on afterwards
#   scripts/rewind-check 3         on battery: why no backup runs (S18-T10)
#   scripts/rewind-check 4         hidden files, and how fast it all opens
#                                  (S18-T11 and T12)
#   scripts/rewind-check 5         on battery: how long a backup waits
#                                  (S18-T14)
#   scripts/rewind-check 6         an upgrade restarts the tray and the
#                                  service by themselves (S18-T13)
#   scripts/rewind-check 7         on the GNOME VM: Rewind over GNOME's,
#                                  Cinnamon's and Xfce's wallpaper, natively
#                                  and in the Flatpak (S18-T2, T19)
#   scripts/rewind-check 8         the same on the Plasma VM
#   scripts/rewind-check 9         on the GNOME VM's Sway: the wallpaper its
#                                  config names, natively and in the Flatpak
#                                  (S18-T20)
#   scripts/rewind-check 9 change  give Sway on the VM a wallpaper of its own
#   scripts/rewind-check 9 done    take it away, and log the VM in to GNOME
#   scripts/rewind-check 10        on the GNOME VM: Rewind's window in front,
#                                  its pictures, walking into folders, and
#                                  leaving where it was (S18-T4)
#   scripts/rewind-check 10 setup  back up a folder of pictures there for it:
#                                  two backups, changed in between and since,
#                                  with the VM's schedule paused for two days
#   scripts/rewind-check 11        on the GNOME VM: Rewind's timeline, its
#                                  labels, marks and magnification, and the
#                                  step arrows (S18-T5)
#   scripts/rewind-check 11 setup  move a file never backed up to the Trash
#                                  there, for a marked tick
#   scripts/rewind-check 12        on the GNOME VM: Restore and Cancel in
#                                  Rewind, a conflict, then Undo (S18-T6)
#
# Run from the checkout.

set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"

say() { printf '\n\033[1m%s\033[0m\n' "$*"; }

case "${1:-}" in
install)
    say "Building the AUR packages from this checkout…"
    just --justfile "$ROOT/Justfile" aur-build >/dev/null
    package="$(ls "$ROOT"/target/aur/backtrack-[0-9]*-x86_64.pkg.tar.zst)"
    cat <<EOF
Built. Install it, and restart the daemon so it runs the same build:

  sudo pacman -U $package
  systemctl --user restart backtrackd.service

Then close Backtrack's window if it is open, and run: scripts/rewind-check 1
EOF
    ;;
1)
    say "1. Rewind's motion (S18-T3)"
    cat <<'EOF'
  a. Open Backtrack, and go to a folder with many backups (Documents, say).
  b. Press Ctrl+T. Rewind opens full screen over the starfield: Backtrack
     does not read Hyprland's wallpaper yet (S18-T15), so the stars are its
     own.
  c. Press Up a few times, one at a time: each step goes back one backup,
     slow, fast, then slow. Then Down to come forward again.
  d. Hold Up for three seconds: the stack glides back through the backups
     without stopping at each one, and settles on one when you let go.
  e. Home goes to the folder as it is now; End to the oldest backup.
  f. The mouse wheel steps too.
  g. Escape: back to Backtrack's window, at the backup it showed.

What I would like to know: does the motion look smooth to you, stepping
and gliding? Anything that stutters, or the stack drawn wrongly anywhere?
EOF
    ;;
2)
    say "2. With animations off (S18-T3)"
    gsettings set org.gnome.desktop.interface enable-animations false
    cat <<'EOF'
Animations are now off for GTK applications.

  a. In Backtrack's window, press Ctrl+T.
  b. Press Up, then Down: the backups crossfade in place, with no flight.
  c. Escape.

Press Enter here when done, and animations go back on.
EOF
    read -r _
    gsettings reset org.gnome.desktop.interface enable-animations
    echo "Animations are on again ($(gsettings get org.gnome.desktop.interface enable-animations))."
    ;;
3)
    say "3. A backup held up on battery says so (S18-T10)"
    if [[ "$(cat /sys/class/power_supply/A*/online 2>/dev/null | head -n 1)" == 1 ]]; then
        echo "Unplug the charger first: this is about running on battery."
    fi
    echo "What backtrack status says now:"
    echo
    backtrack status | sed 's/^/    /'
    cat <<'EOF'

  With backups on battery off (the default), once a backup is due it should
  say "Next backup   waiting for mains power", where it said "due now"
  before, and name the setting.

  a. Open Backtrack: the line at the bottom of the window ends "· waiting for
     charger".
  b. The tray's first line says "Last: 1h ago. Waiting for charger." (with
     the hours since your last backup).
  c. Plug the charger in: within a couple of minutes a backup runs, and the
     waiting is no longer mentioned.
EOF
    ;;
4)
    say "4. Hidden files, and how fast it opens (S18-T11 and T12)"
    cat <<'EOF'
  a. Open Backtrack at your home folder. It should show its contents at once,
     where it took about seven seconds before, and no dotfiles.
  b. Ctrl+H shows the hidden files; Ctrl+H again hides them. Show Hidden
     Files in the main menu is the same switch.
  c. Ctrl+Shift+H is Show All Backups now (it was Ctrl+H).
  d. Ctrl+T for Rewind at your home folder: its cards fill at once (five
     seconds before), with no dotfiles; Ctrl+H there shows them, and the
     window's switch moves with it.
EOF
    ;;
5)
    say "5. On battery, a backup that has waited long enough runs anyway (S18-T14)"
    cat <<'EOF'
  a. In Preferences, Backup page: under Back up on battery power (off) is
     "Wait for mains power", set to "Up to 3 hours". Turn Back up on battery
     power on: that row goes. Turn it off again: it is back.
  b. Unplug the charger, and wait until a backup is due (backtrack status
     says when). Then:
     - the window's bottom line ends "· waiting for charger until HH:MM",
       three hours after the last backup;
     - backtrack status says "Next backup   waiting for mains power until
       <that time> (in …), then backs up on battery anyway
       (backup.on_battery_after)";
     - the tray says "Last: 1h ago. Waiting for charger."
  c. In Preferences, set Wait for mains power to "Up to 1 hour". Within about
     two minutes a backup starts, on battery.
  d. Set it back to "Up to 3 hours", and plug the charger in.
EOF
    ;;
6)
    say "6. An upgrade restarts the tray and the service (S18-T13)"
    package="$(ls "$ROOT"/target/aur/backtrack-[0-9]*-x86_64.pkg.tar.zst)"
    cat <<EOF
  The tray and the service running now are from before this, so after the
  first install below they are restarted by hand, for the last time.

  a. Install it, and restart both:
       sudo pacman -U $package
       systemctl --user restart backtrackd.service
       pkill -x backtrack-tray; setsid -f backtrack-tray >/dev/null 2>&1
  b. Install the same package again (pacman says it is reinstalling):
       sudo pacman -U $package
     Within a minute, with no command: the tray icon goes and comes back, and
       systemctl --user status backtrackd.service
     says it has been running since after the install. Its log says why:
       journalctl --user -u backtrackd.service --since -5min | grep -i upgraded
  c. Back Up Now from the tray, and while it runs, install it a third time.
     The service waits: the log says "restarts once its work is done", and
     it restarts only after the backup has finished. The tray restarts at
     once, and says "Backing up now…" (or the backup's progress) again.
EOF
    ;;
7 | 8)
    if [[ "$1" == 7 ]]; then
        vm="fedora45 (GNOME)"
        desktops="GNOME, then Cinnamon, then Xfce"
    else
        vm="fedora45 (KDE)"
        desktops="Plasma"
    fi
    APP_ID=tools.backtrack.Backtrack
    say "$1. Rewind over the desktop's wallpaper, on $vm"
    cat <<EOF
  For each desktop in turn: $desktops. To change desktop, log out, and on
  the login screen choose it with the gear at the bottom right before
  signing in.

  a. Natively: from the laptop, run
       just vm-app "$vm"
     Backtrack opens on the VM's screen. Press Ctrl+T: Rewind opens full
     screen over this desktop's wallpaper, darkened.
  b. Press Up a few times, then hold it: the cards behind the front one stay
     whole, and fill in by themselves after each step. Escape.
  c. Change the wallpaper in the desktop's own settings, then Ctrl+T again:
     the new wallpaper is behind the stack. Escape, and close Backtrack.
  d. In the Flatpak: from the laptop, run
       ssh "\$(scripts/vm address "$vm")" systemd-run --user flatpak run $APP_ID
     Backtrack opens on the VM's screen again, this time the Flatpak. Press
     Ctrl+T: the same wallpaper. Escape, and close it.

  Tell me, for each desktop, any of a to d that did not happen.
EOF
    ;;
9)
    vm="fedora45 (GNOME)"
    APP_ID=tools.backtrack.Backtrack
    case "${2:-}" in
    change)
        # A wallpaper as a Sway user sets one: in a config of their own,
        # here through an include and a variable, read after Fedora's.
        ssh "$("$ROOT/scripts/vm" address "$vm")" 'set -e
            mkdir -p ~/.config/sway/config.d
            printf "%s\n" "# Written by scripts/rewind-check 9 (S18-T20)." \
                "include /etc/sway/config" "include ~/.config/sway/config.d/*" \
                > ~/.config/sway/config
            printf "%s\n" "set \$wallpaper /usr/share/backgrounds/images/ladybugs.jpg" \
                "output * bg \$wallpaper fill" > ~/.config/sway/config.d/wallpaper.conf
            SWAYSOCK="$(systemctl --user show-environment | sed -n "s/^SWAYSOCK=//p")" \
                swaymsg reload >/dev/null'
        echo "Sway on the VM now shows the ladybugs, from ~/.config/sway/config."
        ;;
    done)
        ssh "$("$ROOT/scripts/vm" address "$vm")" 'set -e
            rm -rf ~/.config/sway
            sudo busctl call org.freedesktop.Accounts /org/freedesktop/Accounts/User1000 \
                org.freedesktop.Accounts.User SetSession s gnome
            sudo systemctl restart gdm'
        echo "The VM has Fedora's Sway config again, and is logged in to GNOME."
        ;;
    *)
        say "9. Rewind over Sway's wallpaper, on $vm"
        cat <<EOF
  The VM is logged in to Sway: its blue wallpaper, and a bar at the bottom.

  a. Natively: from the laptop, run
       just vm-app "$vm"
     Backtrack opens on the VM's screen, filling it. Press Ctrl+T: Rewind
     opens over Sway's blue wallpaper, darkened. Escape.
  b. From the laptop, run
       scripts/rewind-check 9 change
     The VM's wallpaper becomes ladybugs on leaves. Press Ctrl+T again: the
     ladybugs are behind the stack. Escape, and close Backtrack with its
     close button.
  c. In the Flatpak: from the laptop, run
       ssh "\$(scripts/vm address "$vm")" systemd-run --user flatpak run $APP_ID
     Press Ctrl+T: the ladybugs again, which the Flatpak reads from Sway's
     config. Escape, and close it.
  d. From the laptop, run
       scripts/rewind-check 9 done
     The VM goes back to GNOME.

  Tell me any of a to d that did not happen.
EOF
        ;;
    esac
    ;;
10)
    vm="fedora45 (GNOME)"
    if [[ "${2:-}" == setup ]]; then
        # ~/Pictures, backed up by the VM's development service: six files,
        # then stone_bird.jpg replaced by another picture and
        # tiny_blast_of_red.jpg deleted, backed up again, then ladybugs.jpg
        # changed on the disk only. The schedule is paused first (a backup
        # asked for still runs), so the two stay the newest: an hourly
        # backup after them would hold the change made since. Both survive
        # the prune that ends each backup, which keeps every backup from the
        # last day (S18-T22); a build before that keeps only the latest in
        # each hour.
        ssh "$("$ROOT/scripts/vm" address "$vm")" 'set -e
            cli() { BACKTRACK_DEV=1 "$HOME/backtrack/target/debug/backtrack" "$@"; }
            settle() {
                for _ in $(seq 1 45); do
                    cli status | grep -qiE "backing up|cataloguing" || return 0
                    sleep 4
                done
            }
            cli pause 2d >/dev/null
            rm -rf ~/Pictures && mkdir -p ~/Pictures
            cp /usr/share/backgrounds/images/{earth_from_space,flowers_and_leaves,ladybugs,stone_bird,tiny_blast_of_red}.jpg ~/Pictures/
            cp /usr/share/backgrounds/sway/Sway_Wallpaper_Blue_1920x1080.png ~/Pictures/sway-blue.png
            echo "Shopping: milk, bread" > ~/Pictures/notes.txt
            cli config set backup.include "[\"$HOME/.local/share/backtrack-dev/demo-src\", \"$HOME/Pictures\"]" >/dev/null
            cli backup-now >/dev/null && sleep 2 && settle
            cp ~/Pictures/ladybugs.jpg ~/Pictures/stone_bird.jpg
            rm ~/Pictures/tiny_blast_of_red.jpg
            cli backup-now >/dev/null && sleep 2 && settle
            sleep 2
            cp ~/Pictures/earth_from_space.jpg ~/Pictures/ladybugs.jpg'
        echo "Pictures, in the VM's home folder, is backed up twice, and changed since."
        echo "The VM's scheduled backups are paused for two days."
        exit 0
    fi
    say "10. Rewind's window in front, on $vm (S18-T4)"
    cat <<EOF
  The two newest backups of ~/Pictures on the VM are the ones
  scripts/rewind-check 10 setup made: between them, stone_bird.jpg was
  replaced by the ladybugs picture and tiny_blast_of_red.jpg deleted; since
  the second, ladybugs.jpg has been replaced by the earth picture, on the
  disk only. Setup pauses the VM's schedule for two days so that no hourly
  backup comes after them (the window says backups are paused). If the
  VM's status shows a backup newer than setup's, run setup again first.

  a. On the VM, open Files at Pictures, wait for its thumbnails, and close
     it: the desktop's thumbnails are what Rewind shows first. Then, from
     the laptop:
       just vm-app "$vm" --select /home/keith/Pictures/stone_bird.jpg
     Backtrack opens at Pictures with stone_bird.jpg selected.
  b. Press Ctrl+T. Rewind opens at the newest backup, as icons, with
     stone_bird.jpg selected, on the cards behind too. Real pictures for
     earth_from_space, flowers_and_leaves, stone_bird (showing ladybugs) and
     sway-blue; ladybugs.jpg shows ladybugs after a moment (made from the
     backup, not the earth now on the disk); notes.txt, its icon. Every
     cell is the same height.
  c. Press Up: setup's first backup comes to the front.
     tiny_blast_of_red.jpg is back, marked "deleted", and stone_bird.jpg is
     marked "changed" and shows the stone bird; both pictures arrive a
     moment after. Hover a badge: its tooltip says the rest. Press Home:
     the folder as it is now, ladybugs.jpg showing the earth. Press End:
     the oldest backup that holds Pictures comes to the front.
  d. Press Left and Right: the selection moves among the icons. Up and Down
     still step through time.
  e. Click the list button, right of the date: the folder as the main
     window's list, with its columns and badges. Click the icons button.
  f. Press Alt+Up: Rewind goes up to your home folder, its backups listed
     for it. Double-click Pictures (or press Enter on it): back in Pictures.
     Click "Home" in the window's trail, then walk back in the same way.
  g. Select flowers_and_leaves.jpg and press Escape. Backtrack's window shows
     Pictures with flowers_and_leaves.jpg selected.

  Tell me any of a to g that did not happen, or did and looked wrong.
EOF
    ;;
11)
    vm="fedora45 (GNOME)"
    if [[ "${2:-}" == setup ]]; then
        # A file made and moved to the Trash before any backup has it: the
        # Trash's entry for it is listed for Pictures, after the newest
        # backup (Stage 16).
        ssh "$("$ROOT/scripts/vm" address "$vm")" 'set -e
            echo "A draft, never backed up." > ~/Pictures/draft.txt
            gio trash ~/Pictures/draft.txt'
        echo "draft.txt, in Pictures on the VM, is in the Trash and in no backup."
        exit 0
    fi
    say "11. Rewind's timeline, on $vm (S18-T5)"
    cat <<EOF
  scripts/rewind-check 11 setup has moved draft.txt, never backed up, from
  ~/Pictures to the Trash on the VM. Close any Backtrack window open there
  first: a new one would hand over to it.

  a. From the laptop:
       just vm-app "$vm" --select /home/keith/Pictures/stone_bird.jpg
     then press Ctrl+T. Down the right-hand edge, a tick for each backup
     listed for Pictures: the oldest at the top, "Today (Now)" at the
     bottom, and "Yesterday" at yesterday's newest backup. The tick of the
     backup in front is longer and blue, with a blue marker beside it. Just
     above now's tick, a red one: the Trash's entry for draft.txt.
  b. Move the pointer slowly up and down the ticks: those near it lengthen
     and thicken, and labels near it grow, falling off over a few ticks
     either side; a plain tick under the pointer turns white. Move away:
     they settle back. Rest on a tick: it names its backup ("Today, 08:26";
     the red one ends "· trashed").
  c. Click a tick a few backups back: the stack flies to it, and the marker
     travels with the stack, between the ticks. The lines under the stack
     follow. Click "Today (Now)"'s tick to come back.
  d. Press Up and Down, then turn the wheel with the pointer over the
     timeline: the marker follows each step.
  e. The two round arrows left of the timeline: the upper goes one backup
     older, the lower one newer, and each changes colour under the pointer.
     At now, the lower is greyed; press End, and at the oldest the upper is.
  f. Press Escape, then from the laptop:
       just vm-app "$vm" --path /home/keith/.local/share/backtrack-dev/demo-src
     and press Ctrl+T. Rewind lists only the backups in which the folder
     changed: demo-src last changed on 31 October, so its eight ticks are
     now, today's newest backup, five in October and one in September, and
     the labels read "Today (Now)", "October" (at 31 Oct) and "September".
  g. In the VM's Settings, Appearance, choose Dark, and open Rewind again:
     the arrows turn dark, and the timeline stays light on the wallpaper.
     Choose Light again after.

  Tell me any of a to g that did not happen, or did and looked wrong.
EOF
    ;;
12)
    vm="fedora45 (GNOME)"
    say "12. Restore and Cancel in Rewind, on $vm (S18-T6)"
    cat <<EOF
  Uses step 10's backups of ~/Pictures on the VM. Close any Backtrack window
  open there first: a new one would hand over to it.

  a. From the laptop:
       just vm-app "$vm" --select /home/keith/Pictures/stone_bird.jpg
     then press Ctrl+T. Under the stack: Cancel, the date and "Backup n of
     m", and Restore, in blue. Press Home: at "Today (Now)" Restore is
     greyed. Press Up until stone_bird.jpg shows the stone bird, marked
     "changed", with tiny_blast_of_red.jpg beside it, marked "deleted":
     setup's first backup.
  b. stone_bird.jpg selected, click Restore. Over Rewind, the dialog asking
     whether to replace stone_bird.jpg, as the window asks. Choose Cancel:
     Rewind stays, nothing changed.
  c. Click Restore again and choose Replace. Rewind closes; the window shows
     Pictures with stone_bird.jpg selected, and a toast says it was
     restored, with Undo. On the VM, Files shows stone_bird.jpg as the stone
     bird.
  d. Click Undo within ten seconds: the toast says it was put back, and
     stone_bird.jpg is the ladybugs again.
  e. Ctrl+T, go back to the same backup, select tiny_blast_of_red.jpg and
     press Enter: nothing is in its way, so it is restored without a
     question; Rewind closes, and the toast offers Undo. Click Undo: it is
     gone again.
  f. Ctrl+T, go to the same backup, and press Alt+Up: Rewind is at your
     home folder. Select Pictures and click Restore: over Rewind, the
     summary of what restoring the folder would change. Cancel it: Rewind
     stays. Press Enter: Pictures opens, as Enter on a folder does.
  g. Click Cancel: Rewind closes, nothing changed. Ctrl+T again and press
     Escape: the same.

  Tell me any of a to g that did not happen, or did and looked wrong.
EOF
    ;;
*)
    sed -n '/^# Stage 18/,/^# Run from/p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
    ;;
esac
