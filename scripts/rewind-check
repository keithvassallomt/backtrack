#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# SPDX-FileCopyrightText: 2026 Keith Vassallo <keith@vassallo.cloud>
#
# Stage 18's checks on this computer, by hand: whether Rewind's motion looks
# smooth on real hardware, which no virtual machine can say, and its
# crossfade with animations off (S18-T3); a backup held up on battery saying
# so (S18-T10); hidden files, and a quick opening on a large catalogue (S18-T11
# and T12); a backup on battery that has waited long enough running anyway
# (S18-T14); the tray and the service restarting after an upgrade (S18-T13).
# Each step says what to do at the screen.
#
#   scripts/rewind-check install   build the AUR packages here and say how to
#                                  install them
#   scripts/rewind-check 1         the motion, through a real folder's backups
#   scripts/rewind-check 2         with animations off: a crossfade instead;
#                                  puts animations back on afterwards
#   scripts/rewind-check 3         on battery: why no backup runs (S18-T10)
#   scripts/rewind-check 4         hidden files, and how fast it all opens
#                                  (S18-T11 and T12)
#   scripts/rewind-check 5         on battery: how long a backup waits
#                                  (S18-T14)
#   scripts/rewind-check 6         an upgrade restarts the tray and the
#                                  service by themselves (S18-T13)
#   scripts/rewind-check 7         on the GNOME VM: Rewind over GNOME's,
#                                  Cinnamon's and Xfce's wallpaper, natively
#                                  and in the Flatpak (S18-T2, T19)
#   scripts/rewind-check 8         the same on the Plasma VM
#
# Run from the checkout.

set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"

say() { printf '\n\033[1m%s\033[0m\n' "$*"; }

case "${1:-}" in
install)
    say "Building the AUR packages from this checkout…"
    just --justfile "$ROOT/Justfile" aur-build >/dev/null
    package="$(ls "$ROOT"/target/aur/backtrack-[0-9]*-x86_64.pkg.tar.zst)"
    cat <<EOF
Built. Install it, and restart the daemon so it runs the same build:

  sudo pacman -U $package
  systemctl --user restart backtrackd.service

Then close Backtrack's window if it is open, and run: scripts/rewind-check 1
EOF
    ;;
1)
    say "1. Rewind's motion (S18-T3)"
    cat <<'EOF'
  a. Open Backtrack, and go to a folder with many backups (Documents, say).
  b. Press Ctrl+T. Rewind opens full screen over the starfield: Backtrack
     does not read Hyprland's wallpaper yet (S18-T15), so the stars are its
     own.
  c. Press Up a few times, one at a time: each step goes back one backup,
     slow, fast, then slow. Then Down to come forward again.
  d. Hold Up for three seconds: the stack glides back through the backups
     without stopping at each one, and settles on one when you let go.
  e. Home goes to the folder as it is now; End to the oldest backup.
  f. The mouse wheel steps too.
  g. Escape: back to Backtrack's window, at the backup it showed.

What I would like to know: does the motion look smooth to you, stepping
and gliding? Anything that stutters, or the stack drawn wrongly anywhere?
EOF
    ;;
2)
    say "2. With animations off (S18-T3)"
    gsettings set org.gnome.desktop.interface enable-animations false
    cat <<'EOF'
Animations are now off for GTK applications.

  a. In Backtrack's window, press Ctrl+T.
  b. Press Up, then Down: the backups crossfade in place, with no flight.
  c. Escape.

Press Enter here when done, and animations go back on.
EOF
    read -r _
    gsettings reset org.gnome.desktop.interface enable-animations
    echo "Animations are on again ($(gsettings get org.gnome.desktop.interface enable-animations))."
    ;;
3)
    say "3. A backup held up on battery says so (S18-T10)"
    if [[ "$(cat /sys/class/power_supply/A*/online 2>/dev/null | head -n 1)" == 1 ]]; then
        echo "Unplug the charger first: this is about running on battery."
    fi
    echo "What backtrack status says now:"
    echo
    backtrack status | sed 's/^/    /'
    cat <<'EOF'

  With backups on battery off (the default), once a backup is due it should
  say "Next backup   waiting for mains power", where it said "due now"
  before, and name the setting.

  a. Open Backtrack: the line at the bottom of the window ends "· waiting for
     charger".
  b. The tray's first line says "Last: 1h ago. Waiting for charger." (with
     the hours since your last backup).
  c. Plug the charger in: within a couple of minutes a backup runs, and the
     waiting is no longer mentioned.
EOF
    ;;
4)
    say "4. Hidden files, and how fast it opens (S18-T11 and T12)"
    cat <<'EOF'
  a. Open Backtrack at your home folder. It should show its contents at once,
     where it took about seven seconds before, and no dotfiles.
  b. Ctrl+H shows the hidden files; Ctrl+H again hides them. Show Hidden
     Files in the main menu is the same switch.
  c. Ctrl+Shift+H is Show All Backups now (it was Ctrl+H).
  d. Ctrl+T for Rewind at your home folder: its cards fill at once (five
     seconds before), with no dotfiles; Ctrl+H there shows them, and the
     window's switch moves with it.
EOF
    ;;
5)
    say "5. On battery, a backup that has waited long enough runs anyway (S18-T14)"
    cat <<'EOF'
  a. In Preferences, Backup page: under Back up on battery power (off) is
     "Wait for mains power", set to "Up to 3 hours". Turn Back up on battery
     power on: that row goes. Turn it off again: it is back.
  b. Unplug the charger, and wait until a backup is due (backtrack status
     says when). Then:
     - the window's bottom line ends "· waiting for charger until HH:MM",
       three hours after the last backup;
     - backtrack status says "Next backup   waiting for mains power until
       <that time> (in …), then backs up on battery anyway
       (backup.on_battery_after)";
     - the tray says "Last: 1h ago. Waiting for charger."
  c. In Preferences, set Wait for mains power to "Up to 1 hour". Within about
     two minutes a backup starts, on battery.
  d. Set it back to "Up to 3 hours", and plug the charger in.
EOF
    ;;
6)
    say "6. An upgrade restarts the tray and the service (S18-T13)"
    package="$(ls "$ROOT"/target/aur/backtrack-[0-9]*-x86_64.pkg.tar.zst)"
    cat <<EOF
  The tray and the service running now are from before this, so after the
  first install below they are restarted by hand, for the last time.

  a. Install it, and restart both:
       sudo pacman -U $package
       systemctl --user restart backtrackd.service
       pkill -x backtrack-tray; setsid -f backtrack-tray >/dev/null 2>&1
  b. Install the same package again (pacman says it is reinstalling):
       sudo pacman -U $package
     Within a minute, with no command: the tray icon goes and comes back, and
       systemctl --user status backtrackd.service
     says it has been running since after the install. Its log says why:
       journalctl --user -u backtrackd.service --since -5min | grep -i upgraded
  c. Back Up Now from the tray, and while it runs, install it a third time.
     The service waits: the log says "restarts once its work is done", and
     it restarts only after the backup has finished. The tray restarts at
     once, and says "Backing up now…" (or the backup's progress) again.
EOF
    ;;
7 | 8)
    if [[ "$1" == 7 ]]; then
        vm="fedora45 (GNOME)"
        desktops="GNOME, then Cinnamon, then Xfce"
    else
        vm="fedora45 (KDE)"
        desktops="Plasma"
    fi
    APP_ID=tools.backtrack.Backtrack
    say "$1. Rewind over the desktop's wallpaper, on $vm"
    cat <<EOF
  For each desktop in turn: $desktops. To change desktop, log out, and on
  the login screen choose it with the gear at the bottom right before
  signing in.

  a. Natively: from the laptop, run
       just vm-app "$vm"
     Backtrack opens on the VM's screen. Press Ctrl+T: Rewind opens full
     screen over this desktop's wallpaper, darkened.
  b. Press Up a few times, then hold it: the cards behind the front one stay
     whole, and fill in by themselves after each step. Escape.
  c. Change the wallpaper in the desktop's own settings, then Ctrl+T again:
     the new wallpaper is behind the stack. Escape, and close Backtrack.
  d. In the Flatpak: from the laptop, run
       ssh "\$(scripts/vm address "$vm")" systemd-run --user flatpak run $APP_ID
     Backtrack opens on the VM's screen again, this time the Flatpak. Press
     Ctrl+T: the same wallpaper. Escape, and close it.

  Tell me, for each desktop, any of a to d that did not happen.
EOF
    ;;
*)
    sed -n '/^# Stage 18/,/^# Run from/p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
    ;;
esac
