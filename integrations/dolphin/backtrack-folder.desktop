#
# "Browse Backups of This Folder…" on a selected folder in Dolphin, or on the
# empty space of the folder being shown, in the same Backtrack submenu as
# backtrack.desktop. A file of its own because KIO filters by type per file,
# not per action, and this item is for folders only. "Rewind This Folder…"
# beside it opens Rewind, the full-screen view, on the folder (S18-T7).
[Desktop Entry]
Type=Application
Name=Backtrack
NoDisplay=true
MimeType=inode/directory;
X-KDE-Submenu=Backtrack
X-KDE-Priority=TopLevel
X-KDE-Protocols=file
X-KDE-RequiredNumberOfUrls=1
Actions=backtrackThisFolder;backtrackTimeViewFolder

[Desktop Action backtrackThisFolder]
Name=Browse Backups of This Folder…
Icon=folder-open-recent
Exec=backtrack-gtk --path %f

[Desktop Action backtrackTimeViewFolder]
Name=Rewind This Folder…
Icon=tools.backtrack.Backtrack-rewind-symbolic
Exec=backtrack-gtk --rewind --path %f
